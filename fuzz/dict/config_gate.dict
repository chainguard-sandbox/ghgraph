# config.rs field vocabulary. The gate is serde-driven, so the fuzzer has to
# guess exact key spellings before it can reach any validation branch;
# config_gate was still finding edges at 91% elapsed on 900s.
k_repos="\"repos\""
k_repo="\"repo\""
k_scope="\"scope\""
k_db_path="\"db_path\""
k_exclude="\"exclude_authors\""
k_lookback="\"default_lookback_days\""
k_workers="\"default_workers\""
k_rate_floor="\"default_rate_limit_floor\""
k_retry_att="\"default_retry_attempts\""
k_retry_bud="\"default_retry_budget\""
k_rev_closed="\"default_reverify_closed_days\""
k_rev_open="\"default_reverify_open_days\""
k_rc="\"reverify_closed_days\""
k_ro="\"reverify_open_days\""
v_viewer="\"viewer\""
v_project="\"project\""
v_issues="\"issues\""
# Structural JSON, so mutation can build objects rather than discover braces.
j_obj="{}"
j_arr="[]"
j_open="{\""
j_kv="\":"
j_comma="\",\""
j_true="true"
j_false="false"
j_null="null"
j_neg="-1"
j_zero="0"
j_big="99999999999999999999"
# Repo shape the config validates.
r_ok="\"owner/name\""
r_slash="\"/\""
r_dbl="\"a//b\""
